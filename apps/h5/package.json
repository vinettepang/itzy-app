{
  "name": "@itzy-app/h5",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=16.14.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "mirror:noth:offline": "node scripts/mirror-noth-offline-all.mjs && node scripts/finalize-noth-offline.mjs",
    "mirror:noth:full": "node scripts/mirror-noth-full.mjs && node scripts/mirror-noth-offline-all.mjs && node scripts/finalize-noth-offline.mjs",
    "mirror:traumclub:offline": "node scripts/mirror-traumclub-offline.mjs",
    "mirror:thefutureinblack:offline": "node scripts/mirror-thefutureinblack-offline.mjs && node scripts/finalize-thefutureinblack-offline.mjs",
    "build:tfib-snapshot": "node scripts/build-tfib-react-snapshot.mjs"
  },
  "dependencies": {
    "@paper-design/shaders-react": "^0.0.80",
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "matter-js": "^0.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "three": "^0.184.0",
    "workbox-window": "^7.1.0"
  },
  "devDependencies": {
    "@types/matter-js": "^0.20.2",
    "@types/node": "^16.18.126",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.16",
    "playwright": "1.51.0",
    "sass": "^1.99.0",
    "typescript": "~5.4.5",
    "vite": "^4.5.5",
    "vite-plugin-pwa": "^0.20.0"
  }
}
