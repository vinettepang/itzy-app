<!-- Ruban Awwwards : blanc sur fond sombre, noir sur fond clair (lit le fond sous le centre du ruban) ; s'efface en glissant quand il croise du texte. -->
<style>#awwwards{transition:opacity .5s cubic-bezier(.22,1,.36,1),transform .6s cubic-bezier(.22,1,.36,1)}#awwwards.is-away{opacity:0;transform:translate(-40%,-50%) !important;pointer-events:none}</style>
<script>
(function () {
  var a = document.getElementById('awwwards');
  if (!a) return;
  var bg = a.querySelector('.js-color-bg'), tx = a.querySelector('.js-color-text'), dark = null, away = false, raf = 0, back = 0;
  function lum(c) {
    var m = c.match(/[\d.]+/g);
    if (!m || m.length < 3 || (m.length > 3 && +m[3] === 0)) return null;
    return 0.2126 * m[0] + 0.7152 * m[1] + 0.0722 * m[2];
  }
  function under(r) {
    var els = document.elementsFromPoint(r.left + r.width / 2, r.top + r.height / 2);
    for (var i = 0; i < els.length; i++) {
      if (a.contains(els[i])) continue;
      for (var e = els[i]; e && e !== document.documentElement; e = e.parentElement) {
        var l = lum(getComputedStyle(e).backgroundColor);
        if (l !== null) return l;
      }
    }
    return 255;
  }
  function textNear(r) {
    var m = 10, box = {l: r.left - m, t: r.top - m, r: r.right + m, b: r.bottom + m}, seen = [];
    for (var y = box.t; y <= box.b; y += (box.b - box.t) / 8) {
      for (var x = Math.max(0, box.l); x <= box.r; x += (box.r - Math.max(0, box.l)) / 3) {
        var els = document.elementsFromPoint(x, y);
        for (var i = 0; i < els.length; i++) {
          var e = els[i];
          if (a.contains(e) || seen.indexOf(e) > -1) continue;
          seen.push(e);
          for (var n = e.firstChild; n; n = n.nextSibling) {
            if (n.nodeType !== 3 || !n.nodeValue.trim()) continue;
            var g = document.createRange(); g.selectNodeContents(n);
            var rs = g.getClientRects();
            for (var k = 0; k < rs.length; k++) {
              var q = rs[k];
              if (q.width && q.right > box.l && q.left < box.r && q.bottom > box.t && q.top < box.b) return true;
            }
          }
        }
      }
    }
    return false;
  }
  function update() {
    raf = 0;
    var w = a.offsetWidth, h = a.offsetHeight, top = (innerHeight - h) / 2;
    var r = {left: 0, right: w, top: top, bottom: top + h, width: w, height: h};
    var d = under(r) < 128;
    if (d !== dark) {
      dark = d;
      bg.setAttribute('fill', d ? 'white' : 'black');
      tx.setAttribute('fill', d ? 'black' : 'white');
    }
    if (textNear(r)) {
      clearTimeout(back); back = 0;
      if (!away) { away = true; a.classList.add('is-away'); }
    } else if (away && !back) {
      back = setTimeout(function () { back = 0; away = false; a.classList.remove('is-away'); }, 350);
    }
  }
  function queue() { if (!raf) raf = requestAnimationFrame(update); }
  addEventListener('scroll', queue, {passive: true});
  addEventListener('wheel', queue, {passive: true});
  addEventListener('touchmove', queue, {passive: true});
  addEventListener('resize', queue);
  setInterval(update, 200);
  update();
})();
</script>

<!-- Lanceur ASK US du chat : s'efface en glissant vers la droite quand il croise du texte ou un CTA (lien ou bouton de 120 px de haut au plus, pour ignorer les cartes projets ; au repos seulement), revient ensuite. -->
<style>.nw{transition:opacity .5s cubic-bezier(.22,1,.36,1),translate .6s cubic-bezier(.22,1,.36,1)}.nw.nw-away[data-state=idle]{opacity:0;translate:40% 0;pointer-events:none}</style>
<script>
(function () {
  var nw = null, away = false, raf = 0, back = 0;
  function px(v, d) { var n = parseFloat(v); return isNaN(n) ? d : n; }
  function hit(box) {
    var seen = [], dx = (box.r - box.l) / 3, dy = (box.b - box.t) / 3;
    for (var y = box.t; y <= box.b + 0.5; y += dy) {
      for (var x = box.l; x <= box.r + 0.5; x += dx) {
        var els = document.elementsFromPoint(Math.min(x, innerWidth - 1), Math.min(y, innerHeight - 1));
        for (var i = 0; i < els.length; i++) {
          var e = els[i];
          if (nw.contains(e) || seen.indexOf(e) > -1) continue;
          seen.push(e);
          var c = e.closest('a,button,[role=button],input,select,textarea');
          if (c && !nw.contains(c)) {
            var q = c.getBoundingClientRect();
            if (q.width && q.height <= 120 && q.right > box.l && q.left < box.r && q.bottom > box.t && q.top < box.b) return true;
          }
          for (var n = e.firstChild; n; n = n.nextSibling) {
            if (n.nodeType !== 3 || !n.nodeValue.trim()) continue;
            var g = document.createRange(); g.selectNodeContents(n);
            var rs = g.getClientRects();
            for (var k = 0; k < rs.length; k++) {
              var r = rs[k];
              if (r.width && r.right > box.l && r.left < box.r && r.bottom > box.t && r.top < box.b) return true;
            }
          }
        }
      }
    }
    return false;
  }
  function update() {
    raf = 0;
    nw = nw && nw.isConnected ? nw : document.querySelector('.nw');
    if (!nw) return;
    var st = getComputedStyle(nw), m = 10;
    var size = px(st.getPropertyValue('--nw-size'), 64), right = px(st.getPropertyValue('--nw-right'), 24), bottom = px(st.getPropertyValue('--nw-bottom'), 24);
    var box = {l: innerWidth - right - size - m, r: innerWidth - right + m, t: innerHeight - bottom - size - m, b: innerHeight - bottom + m};
    var idle = (nw.getAttribute('data-state') || 'idle') === 'idle';
    if (idle && hit(box)) {
      clearTimeout(back); back = 0;
      if (!away) { away = true; nw.classList.add('nw-away'); }
    } else if (away && !back) {
      back = setTimeout(function () { back = 0; away = false; nw.classList.remove('nw-away'); }, 350);
    }
  }
  function queue() { if (!raf) raf = requestAnimationFrame(update); }
  addEventListener('scroll', queue, {passive: true});
  addEventListener('wheel', queue, {passive: true});
  addEventListener('touchmove', queue, {passive: true});
  addEventListener('resize', queue);
  setInterval(update, 200);
})();
</script>
<script src="https://cdn.prod.website-files.com/6a0c501c42b9751b78a9d1a7%2F689e5ba67671442434f3ca35%2F6ac61aadcdbdf1f80f22ec92%2Fasklauncherlift-1.0.0.js" type="text/javascript"></script></body></html>