      + R + ' .ncb-btn:hover{background:#fff;color:#000}'
      + R + ' .ncb-btn:focus-visible,' + R + ' .ncb-text a:focus-visible{outline:2px solid currentColor;outline-offset:3px}'
      + '@media (max-width:720px){' + R + '{left:12px;right:12px;bottom:12px;width:auto;padding:16px}' + R + ' .ncb-text{font-size:16px}}'
      + '@media (prefers-reduced-motion:reduce){' + R + '{transition:none}}';
  }
  function build() {
    if (document.getElementById(ID)) return;
    if (!document.body) { document.addEventListener('DOMContentLoaded', build); return; }
    var st = document.createElement('style');
    st.id = ID + '-css';
    st.textContent = css();
    document.head.appendChild(st);
    var d = document.createElement('div');
    d.id = ID;
    d.setAttribute('role', 'dialog');
    d.setAttribute('aria-modal', 'false');
    d.setAttribute('aria-label', 'Cookies');
    d.innerHTML = '<span class="ncb-label" aria-hidden="true">( Cookies )</span>'
      + '<p class="ncb-text">We use audience measurement and advertising cookies (Google Analytics, Metricool, LinkedIn, Brevo) only if you agree. <a href="https://legal.noth.in" target="_blank" rel="noopener">Privacy policy</a></p>'
      + '<div class="ncb-actions"><button type="button" class="ncb-btn ncb-no">Decline</button><button type="button" class="ncb-btn ncb-ok">Accept</button></div>';
    function close() {
      d.classList.add('ncb-out');
      setTimeout(function () { d.remove(); var s = document.getElementById(ID + '-css'); if (s) s.remove(); }, 450);
    }
    d.querySelector('.ncb-no').onclick = function () {
      save('denied');
      if (window.gtag) gtag('consent', 'update', {analytics_storage:'denied', ad_storage:'denied', ad_user_data:'denied', ad_personalization:'denied'});
      close();
    };
    d.querySelector('.ncb-ok').onclick = function () {
      save('granted');
      if (window.nothinLoadTrackers) window.nothinLoadTrackers();
      close();
    };
    document.body.appendChild(d);
  }
  window.nothinConsentOpen = build;
  if (!hasChoice() || location.hash === '#cookies') build();
  window.addEventListener('hashchange', function () { if (location.hash === '#cookies') build(); });
})();
</script>

<!-- Chat IA Nothin' (widget v3, lanceur ASK US). Affichage piloté par la case NocoDB client_config.chat_visible (client nothin) : décochée = caché, cochée = visible, sans republier le site (08/10/2026). -->
<script>
  window.NothinChatConfigEndpoint = 'https://n8n.noth.in/webhook/chat-config-v2';
</script>
<script src="https://tools.noth.in/chat/widget-v3.js" data-client="nothin" defer></script>

<!-- Ruban Awwwards Site of the Day (10/08/2026), code officiel awwwards.com/ribbons/sotd/nothin, blanc, bord gauche. Masqué sous 768 px. Ruban CSSDA WOTD (15/10/2026) à empiler quand Thomas l envoie. -->
