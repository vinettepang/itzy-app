  "the-hall": {
    "id": 3,
    "title": "The Hall",
    "subtitle": "The low-cost theatre at the heart of the community.",
    "slug": "the-hall",
    "sort": 3,
    "isComingSoon": false,
    "text": "<p><strong>FROM</strong> big stage staples to independent small-run plays, The Hall Theatre aims to provide an affordable, community-driven way to enjoy this wonderful art-form. In the face of difficult funding conditions, it's more important than ever to find unique ways in which to thrive, and so we're honored to be partnering with them on their visual direction across both physical and digital spaces.</p>",
