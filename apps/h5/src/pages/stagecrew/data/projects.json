  "innerstate": {
    "id": 5,
    "title": "INNERSTATE",
    "subtitle": "Full scholarship sport representation.",
    "slug": "innerstate",
    "sort": 4,
    "isComingSoon": false,
    "text": "<p><strong>INNERSTATE</strong> are a talent agency that represents a diverse range of exceptional athletes, musicians, and stage actors all over the globe, offering support and opportunity through close collaboration and over 20 years of hands-on experience though its full scholarship program, which gives vital mentorship to young talent as they navigate the early stages of their careers. We worked with them to craft a bold, energetic brand direction to match their infectious personalities.</p>",
    "areas": [
      "Strategy",
      "Creative Direction",
      "Visual Identity",
