PORT=3000
# 首次需在 MySQL 中建库 itzy_app，再改 DATABASE_URL，最后在仓库根执行: pnpm run db:push（或 pnpm run db:sync）
#
# 若报错 P1000：USER/PASSWORD 与 MySQL 不一致。改成你本机真实账号，勿照抄示例。
#   有密码   mysql://root:你的密码@127.0.0.1:3306/itzy_app
#   空密码   mysql://root:@127.0.0.1:3306/itzy_app   （root 后须有冒号）
# 密码含 @ # % 等须 URL 编码。自测: mysql -h127.0.0.1 -uroot -p itzy_app
DATABASE_URL=mysql://root:PASSWORD@127.0.0.1:3306/itzy_app
# 小程序/管理端访问上传图等绝对链接；须为局域网可访问的本机 IP（勿用 localhost）
PUBLIC_BASE_URL=http://192.168.1.100:3000

# JWT 鉴权（管理端登录）；生产环境务必修改
JWT_SECRET=change-me-to-a-long-random-string

# 已有用户时是否允许任意邮箱自助注册（默认仅首个用户可自助注册成为超级管理员）
# ALLOW_PUBLIC_REGISTER=true

# 仅在「数据库中没有任何用户」时，启动 API 会自动创建默认超级管理员（可改）
# DEFAULT_SUPER_ADMIN_EMAIL=admin@itzy.local
# DEFAULT_SUPER_ADMIN_PASSWORD=Admin123456
# 设为 true 可关闭该行为（仅走注册页或手工建用户）
# SKIP_DEFAULT_ADMIN=true
